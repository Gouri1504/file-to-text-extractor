# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (local Mongo or Atlas)
MONGO_URI=mongodb://localhost:27017/claim-extractor

# JWT - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-me-with-a-strong-random-string
JWT_EXPIRES_IN=7d

# Cookie security: set to true behind HTTPS in production
COOKIE_SECURE=false
# lax | strict | none. Use "none" (with COOKIE_SECURE=true) when the frontend
# and API are on different sites, e.g. Vercel + Render.
COOKIE_SAMESITE=lax

# Frontend origin used by CORS and OAuth post-callback redirect
CLIENT_URL=http://localhost:5173

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-key

# Optional: Groq API key as a fallback when Gemini fails or is rate-limited.
# Get one at https://console.groq.com/keys (free tier available).
# Leave blank to disable the fallback. Default model is Llama 4 Scout
# (multimodal). PDFs are supported on the fallback path by rasterizing
# the first 5 pages to JPEG server-side (Groq has no native PDF support).
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional: "Ask your documents" (RAG). See VECTOR_DB_DEPLOYMENT.md.
# Pinecone free Starter key from https://app.pinecone.io. Leave blank to
# disable the feature. If the index doesn't exist it is created on startup
# (dimension 384, metric cosine, serverless in PINECONE_CLOUD/REGION).
PINECONE_API_KEY=
PINECONE_INDEX=claim-extractor
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Local embedding model (downloaded once on first use, ~23 MB). No key needed.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Optional: Google sign-in via Firebase Authentication.
# Firebase console -> Project settings -> General -> "Project ID".
# Only the project id is needed to verify ID tokens (no service account).
# Must match VITE_FIREBASE_PROJECT_ID in the frontend. Leave blank to disable.
FIREBASE_PROJECT_ID=
