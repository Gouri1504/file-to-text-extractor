# Base URL for the backend API. In dev this matches the Vite proxy target's
# /api prefix; in production set it to your deployed backend URL.
VITE_API_URL=/api

# Optional: Google sign-in via Firebase Authentication.
# Firebase console -> Project settings -> General -> Your apps -> Web app.
# These are public identifiers, not secrets. The project id must match the
# backend's FIREBASE_PROJECT_ID. Leave blank to hide the Google button.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
